# Môi trường vận hành: development | test | production
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
APP_BASE_URL=http://localhost:3000

# Cơ sở dữ liệu:
# - Chạy PostgreSQL nhúng lưu bền vững trên đĩa: pglite://./data/courtgo-pg
# - Hoặc kết nối PostgreSQL độc lập: postgresql://postgres:postgres@127.0.0.1:5432/courtgo
DATABASE_URL=pglite://./data/courtgo-pg

# Bảo mật phiên và chữ ký nội bộ (bắt buộc thay đổi trên production >= 32 ký tự)
SESSION_SECRET=courtgo-dev-session-secret-key-2026-min-32-chars

# Cấu hình cổng thanh toán (VNPay / Cổng thanh toán Việt Nam)
# PAYMENT_MODE: sandbox | production
# Lưu ý: Trên production, bắt buộc phải cấu hình PAYMENT_MODE=production và đầy đủ khóa bí mật.
PAYMENT_MODE=sandbox
PAYMENT_PROVIDER_NAME=VNPAY_SANDBOX
PAYMENT_MERCHANT_ID=COURTGO_VN_01
PAYMENT_HASH_SECRET=vnpay-sandbox-hmac-sha512-secret-2026-courtgo
PAYMENT_GATEWAY_URL=http://localhost:3000/cong-thanh-toan-sandbox

# Cấu hình gửi Email giao dịch (SMTP / API)
# EMAIL_MODE: log_outbox | smtp_webhook
EMAIL_MODE=log_outbox
EMAIL_FROM=no-reply@courtgo.vn
SMTP_WEBHOOK_URL=
SMTP_API_KEY=

# Cho phép chạy seed dữ liệu mẫu (chỉ bật ở development/test, tuyệt đối false ở production)
ALLOW_SEED_DATA=true
